+# --- vu2cpl patch: unicast host map ----------------------------------------
+# The bundled CLI aims at ip | ~netmask, i.e. the subnet broadcast of HA's own
+# interface, which cannot reach devices on another VLAN. For a serial listed in
+# /config/smarteefi_hosts.json we hand the CLI the device's own IP with a /32
+# mask, so the same arithmetic yields plain routed unicast. Unlisted serials
+# keep the stock broadcast. The map lives outside the component so a HACS
+# update does not delete it. Values: "ip" or {"ip": ..., "name": ...}.
+HOSTS_FILE = "smarteefi_hosts.json"
+OFFLINE_AFTER = 3  # consecutive failed polls before a device is unavailable
+
+
+def _read_host_map(path):
+    if not os.path.exists(path):
+        return {}
+    with open(path) as f:
+        raw = json.load(f)
+    hosts = {}
+    for serial, val in raw.items():
+        if serial.startswith("_"):  # "_comment" keys
+            continue
+        hosts[serial] = {"ip": val} if isinstance(val, str) else dict(val)
+    return hosts
+
+
+def host_info(hass, serial):
+    """Host-map entry for a device serial ({} if unmapped)."""
+    return hass.data.get(DOMAIN, {}).get("hosts", {}).get(serial, {})
+
+
+def cli_target(hass, unique_id, ip_address, netmask):
+    """(ip, netmask) to pass the CLI for this entity/device id."""
+    ip = host_info(hass, unique_id.split(":")[0]).get("ip")
+    if ip:
+        return ip, "255.255.255.255"
+    return ip_address, netmask
