# Host-only excludes for macmini-server
# Immich: thumbnails and transcoded video are regenerated by Immich; the live postgres dir is
# replaced by Immich's nightly dump in /mnt/immich/backups.
/mnt/immich/thumbs
/mnt/immich/encoded-video
/home/manoj/immich-app/postgres
# ALPA replica MariaDB data dir (dumped by DB_DUMPS instead)
/DATA/alpa-replica/mysql
# Plex metadata/caches it rebuilds itself
/DATA/AppData/big-bear-plex/config/Library/Application Support/Plex Media Server/Cache
/DATA/AppData/big-bear-plex/config/Library/Application Support/Plex Media Server/Codecs
/DATA/AppData/big-bear-plex/config/Library/Application Support/Plex Media Server/Media
/DATA/AppData/big-bear-plex/config/Library/Application Support/Plex Media Server/Metadata
