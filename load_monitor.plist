<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- VU2CPL shack: live three-phase load monitor (load_monitor.py) as a user agent.
       Install: cp load_monitor.plist ~/Library/LaunchAgents/com.vu2cpl.load-monitor.plist
                launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.vu2cpl.load-monitor.plist
       Remove:  launchctl bootout gui/$(id -u)/com.vu2cpl.load-monitor
       Page:    http://127.0.0.1:8765/   Log: ~/Library/Logs/load-monitor.log -->
  <key>Label</key><string>com.vu2cpl.load-monitor</string>
  <key>ProgramArguments</key>
  <array>
    <string>/opt/homebrew/bin/python3</string>
    <string>/Users/manoj/projects/vu2cpl-shack/load_monitor.py</string>
  </array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>10</integer>
  <key>StandardOutPath</key><string>/Users/manoj/Library/Logs/load-monitor.log</string>
  <key>StandardErrorPath</key><string>/Users/manoj/Library/Logs/load-monitor.log</string>
</dict>
</plist>
