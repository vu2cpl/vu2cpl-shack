# Backups and OS noise
*.backup
.DS_Store

# Claude Code session metadata
.claude/

# Runtime DXCC data (auto-refreshed daily by the Club Log fetch cron;
# nrsave includes it via the rule #4 extract but flows.json restore +
# next 02:00 cron will repopulate). Public-repo: also reveals the
# operator's worked-DXCC matrix and personal blacklist.
nr_dxcc_seed.json
nr_dxcc_blacklist.json

# Runtime historic event log (lightning strikes + actions, JSONL).
# Append-only; grows unbounded. Not source-controlled — runtime only.
nr_lightning_events.jsonl

# Runtime cty.xml prefix→DXCC map cache (fetched on Node-RED startup).
nr_cty_maps.json

# uibuilder generates instance scaffolding at runtime (package.json, .config,
# dist/, api/, routes/, types/, node_modules, README/LICENSE, …). We only
# source-control our own front-end under uibuilder/shack/src/ — ignore the rest.
/uibuilder/**
!/uibuilder/
!/uibuilder/shack/
!/uibuilder/shack/src/
!/uibuilder/shack/src/**

# Home Assistant automation dumps. Kept OUT of this repo deliberately —
# it is PUBLIC, and the dumps carry household member names, per-person
# geyser schedules and notification targets. Durable copies live in
# ~/Documents/vu2cpl-ha-backups/ (see HANDOVER). This rule exists so a
# stray copy in the working tree can never be committed by accident.
ha_automations*.json
automations-*.json

# Runtime grid-voltage log (append-only, one row per minute from
# solar_inverter_mqtt.py). Lives in ~/ on the Pi, not here — this entry
# just stops a stray copy being committed. It is evidence data, not source.
grid_voltage.csv

# Python bytecode from running the repo's scripts / py_compile
__pycache__/
*.pyc

# Node-RED credentials — encrypted, but kept out of this PUBLIC repo entirely
flows_cred.json

# Shack env files. They live in /etc/default and ~/.config, never here, but
# since 2026-08-29 they carry the Telegram bot token as well as the MQTT
# creds (see MQTT_AUTH.md) — so block a stray working-tree copy outright.
# Same reasoning as flows_cred.json: this repo is PUBLIC.
*.env
.env
vu2cpl-shack.env
