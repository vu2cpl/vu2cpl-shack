# VU2CPL shack: live three-phase load monitor (load_monitor.py) on a Pi.
# Install:  scp load_monitor.py <pi>:~/bin/   (mkdir -p ~/bin first)
#           sudo cp load_monitor.service /etc/systemd/system/ && sudo systemctl daemon-reload
#           sudo systemctl enable --now load-monitor
# Needs HA_URL / HA_TOKEN in /home/vu2cpl/.config/vu2cpl-shack.env (mode 600).
# Page: http://<pi>:8765/   Logs: journalctl -u load-monitor -f
[Unit]
Description=VU2CPL three-phase load monitor (Deye via Home Assistant)
After=network-online.target
Wants=network-online.target

[Service]
User=vu2cpl
ExecStart=/usr/bin/python3 /home/vu2cpl/bin/load_monitor.py --bind 0.0.0.0 --port 8765
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
